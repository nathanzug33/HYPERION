DATABASE_URL="file:./dev.db"
AUTH_SECRET="change-me"
NEXTAUTH_URL="http://localhost:3000"

# Rétention des sessions inactives (minutes)
SESSION_IDLE_TIMEOUT_MINUTES=30

# Seuil de fraîcheur d'une fiche avant signalement (jours)
FICHE_FRAICHEUR_SEUIL_JOURS=30

# Génération de dossiers assistée par IA (CV + transcript -> DC pré-rempli).
# Optionnel : sans clé, le bouton "Générer avec l'IA" affiche un message et
# la création manuelle reste disponible.
ANTHROPIC_API_KEY=

# Uniquement si l'erreur "This API key is not scoped to a workspace" apparaît :
# renseignez l'ID du workspace Anthropic à utiliser. Non nécessaire si la clé
# API a été créée directement pour un workspace (recommandé).
ANTHROPIC_WORKSPACE_ID=

# Intégration Gmail / Google Calendar (connexion par compte BM, OAuth 2.0) —
# à créer dans Google Cloud Console > Google Auth Platform :
# - Client OAuth de type "Application Web", avec comme URI de redirection
#   autorisé EXACTEMENT la valeur de GOOGLE_REDIRECT_URI ci-dessous.
# - Audience externe + statut "Test" tant que l'app n'est pas vérifiée par
#   Google : ajoutez chaque compte Google testeur dans "Utilisateurs test".
# - Onglet "Branding" : nom de l'appli + e-mail d'assistance obligatoires.
# Optionnel : sans ces variables, la fonctionnalité est simplement invisible
# (pas de bouton "Connecter mon compte Google" sur /admin/profil).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="http://localhost:3000/api/google/callback"

# Chiffrement des tokens Google stockés en base (AES-256-GCM, 32 octets hex).
# Générer une valeur avec : openssl rand -hex 32
# Ne jamais la faire tourner sans re-chiffrer les tokens existants (sinon les
# comptes déjà connectés devront se reconnecter).
GOOGLE_TOKEN_ENCRYPTION_KEY=
