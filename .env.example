DATABASE_URL="file:./dev.db"
AUTH_SECRET="change-me"
NEXTAUTH_URL="http://localhost:3000"

# Rétention des sessions inactives (minutes)
SESSION_IDLE_TIMEOUT_MINUTES=30

# Seuil de fraîcheur d'une fiche avant signalement (jours)
FICHE_FRAICHEUR_SEUIL_JOURS=30

# Génération de dossiers assistée par IA (CV + transcript -> DC pré-rempli).
# Optionnel : sans clé, le bouton "Générer avec l'IA" affiche un message et
# la création manuelle reste disponible.
ANTHROPIC_API_KEY=

# Uniquement si l'erreur "This API key is not scoped to a workspace" apparaît :
# renseignez l'ID du workspace Anthropic à utiliser. Non nécessaire si la clé
# API a été créée directement pour un workspace (recommandé).
ANTHROPIC_WORKSPACE_ID=
