// Schéma de données — Portail "Bibliothèque de dossiers de compétences"
//
// Choix de développement local : SQLite (fichier, zéro dépendance externe).
// Pour la production, le cahier des charges impose un hébergement UE : basculez
// `provider` sur "postgresql" et pointez DATABASE_URL vers une instance
// PostgreSQL hébergée en UE. Aucun type spécifique à SQLite n'est utilisé
// (pas d'enum natif, pas de tableau scalaire) : le schéma est portable tel quel.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Comptes et organisations
// ---------------------------------------------------------------------------

// Rôles applicatifs : ADMIN, BM (business manager), CLIENT.
// Stocké en String (pas d'enum natif SQLite) ; les valeurs valides sont
// centralisées dans src/lib/constants.ts.
model User {
  id               String    @id @default(cuid())
  email            String    @unique
  passwordHash     String
  name             String
  role             String // ADMIN | BM | CLIENT
  active           Boolean   @default(true)
  twoFactorEnabled Boolean   @default(false)
  twoFactorSecret  String?
  lastLoginAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Renseigné uniquement pour les comptes CLIENT (auto-déclaratif, page profil).
  poste     String?
  telephone String?

  // Renseigné uniquement pour les comptes CLIENT.
  clientOrganizationId String?
  clientOrganization   ClientOrganization? @relation(fields: [clientOrganizationId], references: [id])

  consultantsSuivis      Consultant[]         @relation("BusinessManagerReferent")
  contactRequests        ContactRequest[]     @relation("ClientDemandeur")
  contactRequestsRecues  ContactRequest[]     @relation("BmNotifie")
  demandesBesoin         DemandeBesoin[]      @relation("ClientDemandeurBesoin")
  accesConsultants       ConsultantAccess[]
  suivisCrees            SuiviCandidat[]
  entreprisesSuivies     Entreprise[]         @relation("BusinessManagerReferentEntreprise")
  suivisCommerciauxCrees SuiviCommercial[]    @relation("SuivisCommerciauxCrees")
  loginLogs              LoginLog[]
  consultationLogs       ConsultationLog[]
  resetTokens            PasswordResetToken[]

  @@index([role])
  @@index([clientOrganizationId])
}

model ClientOrganization {
  id        String   @id @default(cuid())
  name      String
  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// ---------------------------------------------------------------------------
// Référentiels paramétrables par l'administrateur (§7)
// ---------------------------------------------------------------------------

model Secteur {
  id     String  @id @default(cuid())
  label  String  @unique
  ordre  Int     @default(0)
  active Boolean @default(true)

  consultants ConsultantSecteur[]
}

model Expertise {
  id     String  @id @default(cuid())
  label  String  @unique
  ordre  Int     @default(0)
  active Boolean @default(true)

  consultants ConsultantExpertise[]
}

// Barème de séniorité (figé mais paramétrable par l'admin).
model Seniorite {
  id        String  @id @default(cuid())
  label     String  @unique // ex. "Confirmé"
  ordre     Int     @default(0) // ordre d'affichage / tri
  anneesMin Int?
  anneesMax Int?
  active    Boolean @default(true)

  consultants Consultant[]
}

model TypeMobilite {
  id     String  @id @default(cuid())
  label  String  @unique // sur site / hybride / full remote / mobilité nationale / régionale
  ordre  Int     @default(0)
  active Boolean @default(true)

  consultants ConsultantTypeMobilite[]
}

model ZoneGeographique {
  id     String  @id @default(cuid())
  label  String  @unique // région ou département
  ordre  Int     @default(0)
  active Boolean @default(true)

  consultants ConsultantZoneGeographique[]
}

model Competence {
  id     String  @id @default(cuid())
  label  String  @unique // étiquette libre : techno, outil, certification
  active Boolean @default(true)

  consultants ConsultantCompetence[]
}

model Langue {
  id     String  @id @default(cuid())
  label  String  @unique
  active Boolean @default(true)

  consultants ConsultantLangue[]
}

// ---------------------------------------------------------------------------
// Dossier de compétences — enregistrement unique portant
// champs internes (nominatifs) + champs exposables (projection anonymisée).
// C'est la source unique de saisie (principe structurant §2).
// ---------------------------------------------------------------------------

model Consultant {
  id String @id @default(cuid())

  // --- Champs internes (jamais exposés au client) -------------------------
  nom                   String
  prenom                String
  email                 String?
  telephone             String?
  tjmMin                Int?
  tjmMax                Int?
  // Nom du fichier stocké sur disque (storage/cv/, jamais servi directement
  // — voir src/lib/cv-storage.ts et la route de téléchargement protégée),
  // pas une URL publique malgré le nom historique du champ.
  cvFileUrl             String?
  cvFileNomOriginal     String? // pour le Content-Disposition au téléchargement
  notesEntretien        String?
  businessManagerId     String
  businessManager       User      @relation("BusinessManagerReferent", fields: [businessManagerId], references: [id])
  dateRencontre         DateTime?
  statutCandidatInterne String    @default("EN_COURS") // EN_COURS | STAFFE | INDISPONIBLE | A_RECONTACTER

  // RGPD (§8)
  consentementRgpd        Boolean   @default(false)
  consentementDate        DateTime?
  consentementPublication Boolean   @default(false) // consentement spécifique à la publication anonymisée
  dateCollecte            DateTime  @default(now())
  dureeConservationMois   Int       @default(24)
  dateConservationLimite  DateTime?

  // --- Champs exposables (projection anonymisée) --------------------------
  referenceAnonyme         String     @unique // ex. IND-017, ne doit pas trahir l'identité
  intitulePoste            String?
  seniorityId              String?
  seniority                Seniorite? @relation(fields: [seniorityId], references: [id])
  anneesExperienceMin      Int?
  anneesExperienceMax      Int?
  resumeContexte           String?
  disponibilite            String? // IMMEDIATE | SOUS_1_MOIS | SOUS_2_MOIS | SUR_PREAVIS
  disponibiliteConfirmeeLe DateTime?
  typeContrat              String? // REGIE | FORFAIT | TEMPS_PARTAGE

  // Mobilité (§6.3)
  rayonKm                Int?
  ouvertGrandDeplacement Boolean @default(false)
  // Ville de rattachement (précision "ville", jamais l'adresse précise —
  // cohérent avec l'anonymisation : une ville ne trahit pas l'identité).
  // villeLat/villeLng sont résolues automatiquement depuis ce nom (référentiel
  // src/lib/villes-france.ts) pour permettre la recherche "ville + rayon"
  // côté bibliothèque client ; restent nulles si la ville n'est pas reconnue.
  villeRattachement      String?
  villeLat               Float?
  villeLng               Float?

  // Publication (§5.2 / §10)
  statutPublication String    @default("BROUILLON") // BROUILLON | PUBLIEE | DEPUBLIEE | ARCHIVEE
  datePublication   DateTime?
  dateDepublication DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Génération assistée par IA (§ gabarit HYPERION)
  genereParIA           Boolean @default(false)
  sourceCvTexte         String? // texte du CV fourni pour la génération
  sourceTranscriptTexte String? // transcription d'entretien fournie

  secteurs             ConsultantSecteur[]
  expertises           ConsultantExpertise[]
  competences          ConsultantCompetence[]
  typesMobilite        ConsultantTypeMobilite[]
  zonesGeographiques   ConsultantZoneGeographique[]
  langues              ConsultantLangue[]
  contactRequests      ContactRequest[]
  consultationLogs     ConsultationLog[]
  competenceCategories CompetenceCategorie[]
  formations           Formation[]
  experiences          Experience[]
  accesEquipe          ConsultantAccess[]
  suivis               SuiviCandidat[]

  @@index([statutPublication])
  @@index([businessManagerId])
  @@index([seniorityId])
}

// Suivi ATS d'un candidat : notes libres, appels, RDV, rappels programmés,
// et changements de statut du pipeline (loggés automatiquement) — un seul
// modèle plutôt que plusieurs pour garder un historique chronologique
// unifié, simple à afficher en fil d'activité sur la fiche.
model SuiviCandidat {
  id           String     @id @default(cuid())
  consultantId String
  consultant   Consultant @relation(fields: [consultantId], references: [id], onDelete: Cascade)

  type  String // NOTE | APPEL | RDV | RAPPEL | STATUT
  titre String
  notes String?

  // Échéance (RDV/RAPPEL) ; null pour une note, un appel déjà passé, ou un
  // changement de statut (toujours déjà survenu).
  dateProgrammee DateTime?
  fait           Boolean   @default(false)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([consultantId])
  @@index([dateProgrammee])
}

// Accès élargi à un dossier candidat, au-delà du BM référent (§ ATS interne).
// Géré exclusivement par l'administrateur : le référent reste le contact
// principal (notifications, export DC), mais l'admin peut ici donner
// visibilité + droit de modification à d'autres business managers, dossier
// par dossier — utile pour le travail en équipe sur un même candidat sans
// ouvrir tout le vivier à tout le monde.
model ConsultantAccess {
  consultantId String
  consultant   Consultant @relation(fields: [consultantId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@id([consultantId, userId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// CRM — prospection commerciale (§ étoffement ERP). Domaine volontairement
// distinct de l'ATS (Consultant = candidats) et de ClientOrganization (comptes
// ayant un accès effectif à la plateforme) : une Entreprise CRM est un
// compte prospect/client suivi commercialement, qui peut ne jamais avoir
// d'accès à la bibliothèque.
// ---------------------------------------------------------------------------

model Entreprise {
  id String @id @default(cuid())

  nom              String
  secteurActivite  String?
  siteWeb          String?
  adresse          String?
  ville            String?
  codePostal       String?
  tailleEffectif   String?
  statutCommercial String  @default("PROSPECT") // PROSPECT | EN_COURS | CLIENT | PERDU
  notes            String?

  businessManagerId String
  businessManager   User   @relation("BusinessManagerReferentEntreprise", fields: [businessManagerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts Contact[]
  suivis   SuiviCommercial[]

  @@index([businessManagerId])
  @@index([statutCommercial])
}

// Interlocuteur au sein d'une entreprise prospectée (ex. responsable
// qualité, responsable production…) — une entreprise peut en compter
// plusieurs, chacun suivi indépendamment.
model Contact {
  id           String     @id @default(cuid())
  entrepriseId String
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)

  prenom    String
  nom       String
  fonction  String? // ex. Responsable qualité, Responsable production…
  email     String?
  telephone String?
  notes     String?
  principal Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  suivis SuiviCommercial[]

  @@index([entrepriseId])
}

// Suivi CRM : notes libres, appels, RDV, rappels programmés et changements
// de statut commercial (loggés automatiquement) — même modèle unifié que
// SuiviCandidat côté ATS, pour un fil d'activité chronologique par
// entreprise, avec un lien optionnel vers l'interlocuteur concerné.
model SuiviCommercial {
  id           String     @id @default(cuid())
  entrepriseId String
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  contactId    String?
  contact      Contact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)

  type     String // NOTE | APPEL | EMAIL | RDV | RAPPEL | PROPOSITION_ENVOYEE | CONTRAT_SIGNE | STATUT
  // Modalité de l'échange (surtout pertinente pour RDV et APPEL) : VISIO |
  // PHYSIQUE | TELEPHONE. Laissée vide pour les types où elle n'a pas de sens.
  modalite String?
  titre    String
  notes    String?

  dateProgrammee DateTime?
  fait           Boolean   @default(false)

  createdById String
  createdBy   User   @relation("SuivisCommerciauxCrees", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entrepriseId])
  @@index([contactId])
  @@index([dateProgrammee])
}

// Tables de jointure explicites (relations n-n paramétrables) --------------

model ConsultantSecteur {
  consultantId String
  consultant   Consultant @relation(fields: [consultantId], references: [id], onDelete: Cascade)
  secteurId    String
  secteur      Secteur    @relation(fields: [secteurId], references: [id], onDelete: Cascade)

  @@id([consultantId, secteurId])
}

model ConsultantExpertise {
  consultantId String
  consultant   Consultant @relation(fields: [consultantId], references: [id], onDelete: Cascade)
  expertiseId  String
  expertise    Expertise  @relation(fields: [expertiseId], references: [id], onDelete: Cascade)

  @@id([consultantId, expertiseId])
}

model ConsultantCompetence {
  consultantId String
  consultant   Consultant @relation(fields: [consultantId], references: [id], onDelete: Cascade)
  competenceId String
  competence   Competence @relation(fields: [competenceId], references: [id], onDelete: Cascade)

  // Mise en avant dans le bandeau d'en-tête de la fiche ("compétences clés").
  estCle Boolean @default(false)

  @@id([consultantId, competenceId])
}

model ConsultantTypeMobilite {
  consultantId   String
  consultant     Consultant   @relation(fields: [consultantId], references: [id], onDelete: Cascade)
  typeMobiliteId String
  typeMobilite   TypeMobilite @relation(fields: [typeMobiliteId], references: [id], onDelete: Cascade)

  @@id([consultantId, typeMobiliteId])
}

model ConsultantZoneGeographique {
  consultantId       String
  consultant         Consultant       @relation(fields: [consultantId], references: [id], onDelete: Cascade)
  zoneGeographiqueId String
  zoneGeographique   ZoneGeographique @relation(fields: [zoneGeographiqueId], references: [id], onDelete: Cascade)

  @@id([consultantId, zoneGeographiqueId])
}

model ConsultantLangue {
  consultantId String
  consultant   Consultant @relation(fields: [consultantId], references: [id], onDelete: Cascade)
  langueId     String
  langue       Langue     @relation(fields: [langueId], references: [id], onDelete: Cascade)

  // Niveau 1 (notions) à 5 (expert) — cf. gabarit HYPERION (points de niveau).
  niveau Int     @default(3)
  detail String? // ex. "Langue maternelle", "TOEIC 850"

  @@id([consultantId, langueId])
}

// ---------------------------------------------------------------------------
// Gabarit HYPERION — sections détaillées du dossier de compétences
// ---------------------------------------------------------------------------

// "02 — Compétences" : 5 catégories fixes, chacune avec un contenu libre et
// un niveau (points). Distinct des étiquettes filtrable `Competence` ci-dessus.
model CompetenceCategorie {
  id           String     @id @default(cuid())
  consultantId String
  consultant   Consultant @relation(fields: [consultantId], references: [id], onDelete: Cascade)

  categorie String // DOMAINES | LOGICIELS_OUTILS | METHODES_NORMES | SECTEURS | MANAGEMENT
  contenu   String
  niveau    Int    @default(3) // 1 (notions) à 5 (expert)
  ordre     Int    @default(0)

  @@index([consultantId])
}

// "03 — Formations & certifications"
model Formation {
  id           String     @id @default(cuid())
  consultantId String
  consultant   Consultant @relation(fields: [consultantId], references: [id], onDelete: Cascade)

  type          String // FORMATION | CERTIFICATION
  annee         String
  intitule      String
  etablissement String?
  ordre         Int     @default(0)

  @@index([consultantId])
}

// "05 — Expériences détaillées" (missions), 01 se déduit des N premières.
model Experience {
  id           String     @id @default(cuid())
  consultantId String
  consultant   Consultant @relation(fields: [consultantId], references: [id], onDelete: Cascade)

  entreprise             String // "Entreprise cliente" générique si NDA
  secteurActivite        String?
  missionTitre           String
  dateDebut              DateTime?
  dateFin                DateTime? // null = mission en cours
  contexteObjectif       String?
  realisations           String? // une réalisation par ligne
  environnementTechnique String?
  ordre                  Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([consultantId])
}

// ---------------------------------------------------------------------------
// Génération de leads (§5.4)
// ---------------------------------------------------------------------------

model ContactRequest {
  id           String     @id @default(cuid())
  consultantId String
  consultant   Consultant @relation(fields: [consultantId], references: [id], onDelete: Cascade)

  clientUserId String
  clientUser   User   @relation("ClientDemandeur", fields: [clientUserId], references: [id])

  besoin                 String
  localisation           String?
  dateDemarrageSouhaitee DateTime?

  status String @default("NOUVELLE") // NOUVELLE | EN_COURS | TRAITEE | SANS_SUITE

  // BM notifié au moment de la demande (le référent du consultant à cet instant).
  bmNotifieId String?
  bmNotifie   User?   @relation("BmNotifie", fields: [bmNotifieId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([consultantId])
  @@index([clientUserId])
  @@index([status])
}

// Demande de besoin "à froid" : le client décrit un poste à pourvoir sans
// viser un profil précis de la bibliothèque (à la différence de
// ContactRequest, toujours rattachée à un Consultant). Visible par
// l'ensemble du back-office (admin + BM) tant qu'aucun consultant/mission
// précis n'est identifié — pas de référent naturel à la création.
model DemandeBesoin {
  id           String @id @default(cuid())
  clientUserId String
  clientUser   User   @relation("ClientDemandeurBesoin", fields: [clientUserId], references: [id])

  intitulePoste          String
  descriptifPoste        String
  seniorite              String?
  tjmCibleMin            Int?
  tjmCibleMax            Int?
  localisation           String?
  dateDemarrageSouhaitee DateTime?
  dureeEstimee           String? // ex. "3 mois", "6-12 mois", "long terme"

  status String @default("NOUVELLE") // NOUVELLE | EN_COURS | TRAITEE | SANS_SUITE

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientUserId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Journalisation et traçabilité (§5.5)
// ---------------------------------------------------------------------------

model LoginLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  success   Boolean  @default(true)
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model ConsultationLog {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  consultantId String
  consultant   Consultant @relation(fields: [consultantId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@index([userId])
  @@index([consultantId])
  @@index([createdAt])
}
