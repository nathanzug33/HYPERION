// Schéma de données — Portail "Bibliothèque de dossiers de compétences"
//
// Choix de développement local : SQLite (fichier, zéro dépendance externe).
// Pour la production, le cahier des charges impose un hébergement UE : basculez
// `provider` sur "postgresql" et pointez DATABASE_URL vers une instance
// PostgreSQL hébergée en UE. Aucun type spécifique à SQLite n'est utilisé
// (pas d'enum natif, pas de tableau scalaire) : le schéma est portable tel quel.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Comptes et organisations
// ---------------------------------------------------------------------------

// Rôles applicatifs : ADMIN, BM (business manager), CLIENT.
// Stocké en String (pas d'enum natif SQLite) ; les valeurs valides sont
// centralisées dans src/lib/constants.ts.
model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  passwordHash        String
  name                String
  role                String // ADMIN | DIRECTEUR_BU | BM | CLIENT
  active              Boolean   @default(true)
  twoFactorEnabled    Boolean   @default(false)
  twoFactorSecret     String?
  lastLoginAt         DateTime?
  // Verrouillage temporaire après plusieurs échecs de connexion consécutifs
  // (protection brute-force, § MAX_FAILED_LOGIN_ATTEMPTS / LOCKOUT_DURATION_MINUTES).
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  // Connexion Gmail / Google Calendar (OAuth par compte, § intégration
  // Google). Tokens chiffrés au repos (voir src/lib/crypto.ts) — jamais en
  // clair en base. googleEmail : compte Google connecté (généralement le
  // même que l'email de connexion HYPERION, mais pas garanti).
  googleAccessTokenEnc  String?
  googleRefreshTokenEnc String?
  googleTokenExpiresAt  DateTime?
  googleEmail           String?
  googleConnectedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Renseigné uniquement pour les comptes CLIENT (auto-déclaratif, page profil).
  poste     String?
  telephone String?

  // Renseigné uniquement pour les comptes CLIENT.
  clientOrganizationId String?
  clientOrganization   ClientOrganization? @relation(fields: [clientOrganizationId], references: [id])

  consultantsSuivis        Consultant[]         @relation("BusinessManagerReferent")
  contactRequests          ContactRequest[]     @relation("ClientDemandeur")
  contactRequestsRecues    ContactRequest[]     @relation("BmNotifie")
  contactRequestsRepondues ContactRequest[]     @relation("DemandeRepondue")
  demandesBesoin           DemandeBesoin[]      @relation("ClientDemandeurBesoin")
  demandesBesoinRepondues  DemandeBesoin[]      @relation("DemandeBesoinRepondue")
  suivisCrees              SuiviCandidat[]
  entreprisesSuivies       Entreprise[]         @relation("BusinessManagerReferentEntreprise")
  suivisCommerciauxCrees   SuiviCommercial[]    @relation("SuivisCommerciauxCrees")
  besoinsSuivis            Besoin[]             @relation("BusinessManagerReferentBesoin")
  besoinCandidatsCrees     BesoinCandidat[]     @relation("BesoinCandidatCreePar")
  missionsSuivies          Mission[]            @relation("BusinessManagerReferentMission")
  offresSuivies            Offre[]              @relation("BusinessManagerReferentOffre")
  loginLogs                LoginLog[]
  consultationLogs         ConsultationLog[]
  resetTokens              PasswordResetToken[]

  @@index([role])
  @@index([clientOrganizationId])
}

model ClientOrganization {
  id        String   @id @default(cuid())
  name      String
  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// ---------------------------------------------------------------------------
// Référentiels paramétrables par l'administrateur (§7)
// ---------------------------------------------------------------------------

model Secteur {
  id        String  @id @default(cuid())
  label     String  @unique
  ordre     Int     @default(0)
  active    Boolean @default(true)
  // Bloc d'affichage côté fiche candidat (onglet Secteurs) — "INDUSTRIE" |
  // "DIGITAL" (mêmes valeurs que SECTEUR_CATEGORIE / Entreprise.secteurCategorie).
  categorie String?

  consultants          ConsultantSecteur[]
  entreprisesCherchent EntrepriseSecteurRecherche[]
}

// Sous-secteur d'activité "Industrie" — référentiel admin-éditable, distinct
// des secteurs de recherche candidats (EntrepriseSecteurRecherche) qui
// décrivent un besoin de recrutement et non l'activité propre du client.
model Industrie {
  id     String  @id @default(cuid())
  label  String  @unique
  ordre  Int     @default(0)
  active Boolean @default(true)

  entreprises Entreprise[]
}

model Expertise {
  id        String  @id @default(cuid())
  label     String  @unique
  ordre     Int     @default(0)
  active    Boolean @default(true)
  // Bloc d'affichage côté fiche candidat (onglet Compétences) — "INDUSTRIE" | "DIGITAL".
  categorie String?

  consultants          ConsultantExpertise[]
  entreprisesCherchent EntrepriseExpertiseRecherchee[]
}

// Barème de séniorité (figé mais paramétrable par l'admin).
model Seniorite {
  id        String  @id @default(cuid())
  label     String  @unique // ex. "Confirmé"
  ordre     Int     @default(0) // ordre d'affichage / tri
  anneesMin Int?
  anneesMax Int?
  active    Boolean @default(true)

  consultants Consultant[]
}

model TypeMobilite {
  id     String  @id @default(cuid())
  label  String  @unique // sur site / hybride / full remote / mobilité nationale / régionale
  ordre  Int     @default(0)
  active Boolean @default(true)

  consultants ConsultantTypeMobilite[]
}

model ZoneGeographique {
  id     String  @id @default(cuid())
  label  String  @unique // région ou département
  ordre  Int     @default(0)
  active Boolean @default(true)

  consultants ConsultantZoneGeographique[]
}

model Competence {
  id        String  @id @default(cuid())
  label     String  @unique // étiquette libre : techno, outil, certification
  active    Boolean @default(true)
  // Bloc d'affichage côté fiche candidat (onglet Compétences) — "INDUSTRIE" | "DIGITAL".
  categorie String?

  consultants ConsultantCompetence[]
}

model Langue {
  id     String  @id @default(cuid())
  label  String  @unique
  active Boolean @default(true)

  consultants ConsultantLangue[]
}

// ---------------------------------------------------------------------------
// Dossier de compétences — enregistrement unique portant
// champs internes (nominatifs) + champs exposables (projection anonymisée).
// C'est la source unique de saisie (principe structurant §2).
// ---------------------------------------------------------------------------

model Consultant {
  id String @id @default(cuid())

  // --- Champs internes (jamais exposés au client) -------------------------
  nom                   String
  prenom                String
  email                 String?
  telephone             String?
  tjmMin                Int?
  tjmMax                Int?
  // Nom du fichier stocké sur disque (storage/cv/, jamais servi directement
  // — voir src/lib/cv-storage.ts et la route de téléchargement protégée),
  // pas une URL publique malgré le nom historique du champ.
  cvFileUrl             String?
  cvFileNomOriginal     String? // pour le Content-Disposition au téléchargement
  notesEntretien        String?
  businessManagerId     String
  businessManager       User      @relation("BusinessManagerReferent", fields: [businessManagerId], references: [id])
  dateRencontre         DateTime?
  statutCandidatInterne String    @default("EN_COURS") // EN_COURS | STAFFE | INTERCONTRAT | INDISPONIBLE | A_RECONTACTER

  // Coût / marge (§ pilotage financier) — jamais exposés au client, visibles
  // et modifiables par l'admin uniquement (données salariales sensibles).
  // natureContrat conditionne le calcul (voir src/lib/marge.ts) : un salarié
  // (CDI/CDIC) coûte son salaire brut annuel × 1,75 (charges patronales) ;
  // un indépendant coûte exactement le TJM qu'on lui paie, sans coefficient.
  // Coût journalier salarié = (salaireBrutAnnuel × 1,75 + fraisAnnuels) / 218.
  // Coût journalier indépendant = tjmAchat + fraisAnnuels / 218.
  natureContrat      String? // CDI | CDIC | INDEPENDANT
  salaireBrutAnnuel  Int? // salarié (CDI/CDIC) uniquement
  tjmAchat           Int? // indépendant uniquement — TJM payé, sans coefficient
  fraisAnnuels       Int?

  // RGPD (§8)
  consentementRgpd        Boolean   @default(false)
  consentementDate        DateTime?
  consentementPublication Boolean   @default(false) // consentement spécifique à la publication anonymisée
  dateCollecte            DateTime  @default(now())
  dureeConservationMois   Int       @default(24)
  dateConservationLimite  DateTime?

  // --- Champs exposables (projection anonymisée) --------------------------
  referenceAnonyme         String     @unique // ex. IND-017, ne doit pas trahir l'identité
  intitulePoste            String?
  seniorityId              String?
  seniority                Seniorite? @relation(fields: [seniorityId], references: [id])
  anneesExperienceMin      Int?
  anneesExperienceMax      Int?
  resumeContexte           String?
  // Résumé très court (2-3 lignes) généré par IA, pensé pour la carte/aperçu
  // bibliothèque — distinct de resumeContexte (paragraphe plus long, intégré
  // au corps du DC). Alimenté par la génération IA (création ou régénération
  // depuis CV + transcript sur un dossier existant).
  presentationCourte       String?
  disponibilite            String? // IMMEDIATE | SOUS_1_MOIS | SOUS_2_MOIS | SUR_PREAVIS
  disponibiliteConfirmeeLe DateTime?
  typeContrat              String? // REGIE | FORFAIT | TEMPS_PARTAGE

  // Mobilité (§6.3)
  rayonKm                Int?
  ouvertGrandDeplacement Boolean @default(false)
  // Ville de rattachement (précision "ville", jamais l'adresse précise —
  // cohérent avec l'anonymisation : une ville ne trahit pas l'identité).
  // villeLat/villeLng sont résolues automatiquement depuis ce nom (référentiel
  // src/lib/villes-france.ts) pour permettre la recherche "ville + rayon"
  // côté bibliothèque client ; restent nulles si la ville n'est pas reconnue.
  villeRattachement      String?
  villeLat               Float?
  villeLng               Float?

  // Publication (§5.2 / §10)
  statutPublication String    @default("BROUILLON") // BROUILLON | PUBLIEE | DEPUBLIEE | ARCHIVEE
  datePublication   DateTime?
  dateDepublication DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Génération assistée par IA (§ gabarit HYPERION)
  genereParIA           Boolean @default(false)
  sourceCvTexte         String? // texte du CV fourni pour la génération
  sourceTranscriptTexte String? // transcription d'entretien fournie

  secteurs             ConsultantSecteur[]
  expertises           ConsultantExpertise[]
  competences          ConsultantCompetence[]
  typesMobilite        ConsultantTypeMobilite[]
  zonesGeographiques   ConsultantZoneGeographique[]
  langues              ConsultantLangue[]
  contactRequests      ContactRequest[]
  consultationLogs     ConsultationLog[]
  competenceCategories CompetenceCategorie[]
  formations           Formation[]
  experiences          Experience[]
  suivis               SuiviCandidat[]
  propositionsCrm      SuiviCommercial[]
  besoinCandidats      BesoinCandidat[]
  missions             Mission[]
  candidatures         Candidature[]

  @@index([statutPublication])
  @@index([businessManagerId])
  @@index([seniorityId])
}

// Suivi ATS d'un candidat : notes libres, appels, RDV, rappels programmés,
// et changements de statut du pipeline (loggés automatiquement) — un seul
// modèle plutôt que plusieurs pour garder un historique chronologique
// unifié, simple à afficher en fil d'activité sur la fiche.
model SuiviCandidat {
  id           String     @id @default(cuid())
  consultantId String
  consultant   Consultant @relation(fields: [consultantId], references: [id], onDelete: Cascade)

  type  String // NOTE | APPEL | RDV | RAPPEL | STATUT
  titre String
  notes String?

  // Échéance (RDV/RAPPEL) ; null pour une note, un appel déjà passé, ou un
  // changement de statut (toujours déjà survenu).
  dateProgrammee DateTime?
  fait           Boolean   @default(false)

  // Événement Google Calendar créé en miroir (RDV/RAPPEL, si le créateur a
  // connecté son compte Google) — permet de le supprimer en cas de
  // suppression de ce suivi.
  googleEventId String?

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([consultantId])
  @@index([dateProgrammee])
}

// ---------------------------------------------------------------------------
// CRM — prospection commerciale (§ étoffement ERP). Domaine volontairement
// distinct de l'ATS (Consultant = candidats) et de ClientOrganization (comptes
// ayant un accès effectif à la plateforme) : une Entreprise CRM est un
// compte prospect/client suivi commercialement, qui peut ne jamais avoir
// d'accès à la bibliothèque.
// ---------------------------------------------------------------------------

model Entreprise {
  id String @id @default(cuid())

  nom              String
  // Les 2 grands secteurs prédominants de l'ESN — Industrie ou Digital,
  // en écho aux spécialisations des BM. Si "INDUSTRIE" : sous-secteur
  // précisé via industrieId (référentiel admin-éditable).
  secteurCategorie String? // "INDUSTRIE" | "DIGITAL"
  industrieId      String?
  industrie        Industrie? @relation(fields: [industrieId], references: [id])
  siteWeb          String?
  adresse          String?
  ville            String?
  codePostal       String?
  tailleEffectif   String?
  statutCommercial String  @default("PROSPECT") // PROSPECT | EN_COURS | CLIENT | PERDU
  notes            String?

  businessManagerId String
  businessManager   User   @relation("BusinessManagerReferentEntreprise", fields: [businessManagerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts Contact[]
  suivis   SuiviCommercial[]
  besoins  Besoin[]
  missions Mission[]
  offres   Offre[]

  // Profils habituellement recherchés par ce client — alimente les
  // suggestions de candidats correspondants (§ matching simple).
  secteursRecherches    EntrepriseSecteurRecherche[]
  expertisesRecherchees EntrepriseExpertiseRecherchee[]

  @@index([businessManagerId])
  @@index([statutCommercial])
}

model EntrepriseSecteurRecherche {
  entrepriseId String
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  secteurId    String
  secteur      Secteur    @relation(fields: [secteurId], references: [id], onDelete: Cascade)

  @@id([entrepriseId, secteurId])
}

model EntrepriseExpertiseRecherchee {
  entrepriseId String
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  expertiseId  String
  expertise    Expertise  @relation(fields: [expertiseId], references: [id], onDelete: Cascade)

  @@id([entrepriseId, expertiseId])
}

// Interlocuteur au sein d'une entreprise prospectée (ex. responsable
// qualité, responsable production…) — une entreprise peut en compter
// plusieurs, chacun suivi indépendamment.
model Contact {
  id           String     @id @default(cuid())
  entrepriseId String
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)

  prenom    String
  nom       String
  fonction  String? // ex. Responsable qualité, Responsable production…
  email     String?
  telephone String?
  notes     String?
  principal Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  suivis  SuiviCommercial[]
  besoins Besoin[]

  @@index([entrepriseId])
}

// Suivi CRM : notes libres, appels, RDV, rappels programmés et changements
// de statut commercial (loggés automatiquement) — même modèle unifié que
// SuiviCandidat côté ATS, pour un fil d'activité chronologique par
// entreprise, avec un lien optionnel vers l'interlocuteur concerné.
model SuiviCommercial {
  id           String      @id @default(cuid())
  entrepriseId String
  entreprise   Entreprise  @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  contactId    String?
  contact      Contact?    @relation(fields: [contactId], references: [id], onDelete: SetNull)
  // Renseigné lorsque l'action est une proposition d'un candidat ATS à ce
  // contact (§ push candidat → client) : la même ligne apparaît alors dans
  // le fil d'activité du contact ET dans l'historique du candidat.
  consultantId String?
  consultant   Consultant? @relation(fields: [consultantId], references: [id], onDelete: SetNull)

  type     String // NOTE | APPEL | EMAIL | RDV | RAPPEL | PROPOSITION_ENVOYEE | CONTRAT_SIGNE | STATUT
  // Modalité de l'échange (surtout pertinente pour RDV et APPEL) : VISIO |
  // PHYSIQUE | TELEPHONE. Laissée vide pour les types où elle n'a pas de sens.
  modalite String?
  titre    String
  notes    String?

  // Pièce jointe optionnelle (devis, proposition commerciale…), même
  // principe que le stockage des CV : voir src/lib/crm-storage.ts et la
  // route de téléchargement protégée.
  fichierUrl         String?
  fichierNomOriginal String?

  dateProgrammee DateTime?
  fait           Boolean   @default(false)

  // Événement Google Calendar créé en miroir (RDV/RAPPEL, si le créateur a
  // connecté son compte Google) — permet de le supprimer en cas de
  // suppression de ce suivi.
  googleEventId String?

  createdById String
  createdBy   User   @relation("SuivisCommerciauxCrees", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entrepriseId])
  @@index([contactId])
  @@index([consultantId])
  @@index([dateProgrammee])
}

// Besoin exprimé par un client lors d'un RDV de prospection, saisi par le
// BM directement depuis la fiche entreprise (distinct de DemandeBesoin, qui
// est le formulaire self-service du portail client — deux origines, deux
// flux, voir audit produit). Point de départ du staffing : le BM associe
// des candidats du vivier ATS (BesoinCandidat), les fait qualifier en RDV,
// puis retient un candidat au moment de gagner le besoin — ce qui crée la
// Mission correspondante.
model Besoin {
  id String @id @default(cuid())

  entrepriseId String
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  contactId    String?
  contact      Contact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)

  businessManagerId String
  businessManager   User   @relation("BusinessManagerReferentBesoin", fields: [businessManagerId], references: [id])

  intitulePoste          String
  descriptifMissions     String?
  seniorite              String?
  tjmCibleMin            Int?
  tjmCibleMax            Int?
  localisation           String?
  dateDemarrageSouhaitee DateTime?
  dureeEstimee           String? // ex. "3 mois", "6-12 mois", "long terme"

  statut String @default("OUVERT") // OUVERT | GAGNE | PERDU | ABANDONNE

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  candidats BesoinCandidat[]
  missions  Mission[]
  offres    Offre[]

  @@index([entrepriseId])
  @@index([businessManagerId])
  @@index([statut])
}

// Candidat du vivier ATS associé à un besoin — un par ligne, avec son propre
// avancement (proposé, RDV de qualification, retenu ou écarté). Le candidat
// "retenu" au moment où le besoin passe à GAGNE devient la Mission.
model BesoinCandidat {
  id String @id @default(cuid())

  besoinId     String
  besoin       Besoin     @relation(fields: [besoinId], references: [id], onDelete: Cascade)
  consultantId String
  consultant   Consultant @relation(fields: [consultantId], references: [id], onDelete: Cascade)

  statut               String    @default("PROPOSE") // PROPOSE | RDV_QUALIFICATION | RETENU | ECARTE
  dateRdvQualification DateTime?
  notes                String?

  createdById String
  createdBy   User   @relation("BesoinCandidatCreePar", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([besoinId, consultantId])
  @@index([besoinId])
  @@index([consultantId])
}

// Mission en cours (ou terminée) d'un consultant chez un client — créée
// automatiquement quand un Besoin est gagné avec un candidat retenu. Base du
// "portefeuille de missions" par BM (§ audit produit, suite logique du
// pipeline commercial au-delà de CONTRAT_SIGNE).
model Mission {
  id String @id @default(cuid())

  besoinId String?
  besoin   Besoin? @relation(fields: [besoinId], references: [id], onDelete: SetNull)

  entrepriseId String
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id])
  consultantId String
  consultant   Consultant @relation(fields: [consultantId], references: [id])

  businessManagerId String
  businessManager   User   @relation("BusinessManagerReferentMission", fields: [businessManagerId], references: [id])

  intitulePoste String
  tjm           Int?
  dateDebut     DateTime
  dateFinPrevue DateTime?
  dateFinReelle DateTime?
  statut        String    @default("EN_COURS") // EN_COURS | TERMINEE | ROMPUE

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  joursTravailles MissionJoursTravailles[]

  @@index([entrepriseId])
  @@index([consultantId])
  @@index([businessManagerId])
  @@index([statut])
}

// Jours travaillés déclarés en début de mois pour une mission — base de la
// marge mensuelle (marge journalière × jours travaillés). Saisi mois par
// mois plutôt que déduit des dates, pour coller aux jours réellement
// facturés (absences, jours fériés, etc.).
model MissionJoursTravailles {
  id String @id @default(cuid())

  missionId String
  mission   Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  annee           Int
  mois            Int // 1-12
  joursTravailles Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([missionId, annee, mois])
  @@index([missionId])
}

// Offre d'emploi/mission publiable (§ brique ATS "Offres") — soit générée à
// partir d'un Besoin CRM (staffing réactif), soit créée librement pour du
// sourcing proactif (alimenter le vivier sans client identifié). Une fois
// PUBLIEE, visible sans authentification sur /offres/[reference] avec un
// formulaire de candidature public (§ Candidature).
model Offre {
  id String @id @default(cuid())

  // Référence courte utilisée dans l'URL publique — ne trahit rien côté
  // client puisque l'offre elle-même est publique, mais évite d'exposer
  // l'id cuid interne.
  reference String @unique // ex. OFF-001

  titre            String
  descriptif       String?
  profilRecherche  String?
  typeContratOffre String? // CDI | CDIC | INDEPENDANT | STAGE | ALTERNANCE
  tjmMin           Int?
  tjmMax           Int?
  salaireMin       Int?
  salaireMax       Int?
  localisation     String?
  dateDemarrage    DateTime?

  statut            String    @default("BROUILLON") // BROUILLON | PUBLIEE | POURVUE | DEPUBLIEE | ARCHIVEE
  datePublication   DateTime?
  dateDepublication DateTime?

  // Lien optionnel vers le besoin d'origine — une offre peut aussi être
  // libre (sourcing proactif), et un besoin peut donner lieu à plusieurs
  // offres (ex. une en régie, une en CDI).
  besoinId String?
  besoin   Besoin? @relation(fields: [besoinId], references: [id], onDelete: SetNull)

  // Dénormalisé depuis le besoin à la création (si présent) pour filtrer
  // les offres par client sans repasser par le besoin — même principe que
  // Mission.entrepriseId.
  entrepriseId String?
  entreprise   Entreprise? @relation(fields: [entrepriseId], references: [id], onDelete: SetNull)

  businessManagerId String
  businessManager   User   @relation("BusinessManagerReferentOffre", fields: [businessManagerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  candidatures Candidature[]

  @@index([besoinId])
  @@index([entrepriseId])
  @@index([businessManagerId])
  @@index([statut])
}

// Candidature reçue sur une offre publique — formulaire sans authentification,
// donc jamais de confiance a priori sur son contenu. Traitée ensuite par le
// staff : ajoutée au vivier ATS (création d'un Consultant) ou rejetée.
model Candidature {
  id String @id @default(cuid())

  offreId String
  offre   Offre @relation(fields: [offreId], references: [id], onDelete: Cascade)

  nom       String
  prenom    String
  email     String
  telephone String?
  message   String?

  // Même principe de stockage que les CV candidats internes (voir
  // src/lib/cv-storage.ts) : nom de fichier aléatoire, jamais servi
  // directement, téléchargement via route protégée admin.
  cvFileUrl         String?
  cvFileNomOriginal String?

  consentementRgpd Boolean @default(false)

  statut String @default("NOUVELLE") // NOUVELLE | EN_COURS | AJOUTEE_VIVIER | REJETEE

  // Renseigné une fois la candidature ajoutée au vivier ATS.
  consultantId String?
  consultant   Consultant? @relation(fields: [consultantId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([offreId])
  @@index([statut])
}

// Tables de jointure explicites (relations n-n paramétrables) --------------

model ConsultantSecteur {
  consultantId String
  consultant   Consultant @relation(fields: [consultantId], references: [id], onDelete: Cascade)
  secteurId    String
  secteur      Secteur    @relation(fields: [secteurId], references: [id], onDelete: Cascade)

  @@id([consultantId, secteurId])
}

model ConsultantExpertise {
  consultantId String
  consultant   Consultant @relation(fields: [consultantId], references: [id], onDelete: Cascade)
  expertiseId  String
  expertise    Expertise  @relation(fields: [expertiseId], references: [id], onDelete: Cascade)

  @@id([consultantId, expertiseId])
}

model ConsultantCompetence {
  consultantId String
  consultant   Consultant @relation(fields: [consultantId], references: [id], onDelete: Cascade)
  competenceId String
  competence   Competence @relation(fields: [competenceId], references: [id], onDelete: Cascade)

  // Mise en avant dans le bandeau d'en-tête de la fiche ("compétences clés").
  estCle Boolean @default(false)

  @@id([consultantId, competenceId])
}

model ConsultantTypeMobilite {
  consultantId   String
  consultant     Consultant   @relation(fields: [consultantId], references: [id], onDelete: Cascade)
  typeMobiliteId String
  typeMobilite   TypeMobilite @relation(fields: [typeMobiliteId], references: [id], onDelete: Cascade)

  @@id([consultantId, typeMobiliteId])
}

model ConsultantZoneGeographique {
  consultantId       String
  consultant         Consultant       @relation(fields: [consultantId], references: [id], onDelete: Cascade)
  zoneGeographiqueId String
  zoneGeographique   ZoneGeographique @relation(fields: [zoneGeographiqueId], references: [id], onDelete: Cascade)

  @@id([consultantId, zoneGeographiqueId])
}

model ConsultantLangue {
  consultantId String
  consultant   Consultant @relation(fields: [consultantId], references: [id], onDelete: Cascade)
  langueId     String
  langue       Langue     @relation(fields: [langueId], references: [id], onDelete: Cascade)

  // Niveau 1 (notions) à 5 (expert) — cf. gabarit HYPERION (points de niveau).
  niveau Int     @default(3)
  detail String? // ex. "Langue maternelle", "TOEIC 850"

  @@id([consultantId, langueId])
}

// ---------------------------------------------------------------------------
// Gabarit HYPERION — sections détaillées du dossier de compétences
// ---------------------------------------------------------------------------

// "02 — Compétences" : 5 catégories fixes, chacune avec un contenu libre et
// un niveau (points). Distinct des étiquettes filtrable `Competence` ci-dessus.
model CompetenceCategorie {
  id           String     @id @default(cuid())
  consultantId String
  consultant   Consultant @relation(fields: [consultantId], references: [id], onDelete: Cascade)

  categorie String // DOMAINES | LOGICIELS_OUTILS | METHODES_NORMES | SECTEURS | MANAGEMENT
  contenu   String
  niveau    Int    @default(3) // 1 (notions) à 5 (expert)
  ordre     Int    @default(0)

  @@index([consultantId])
}

// "03 — Formations & certifications"
model Formation {
  id           String     @id @default(cuid())
  consultantId String
  consultant   Consultant @relation(fields: [consultantId], references: [id], onDelete: Cascade)

  type          String // FORMATION | CERTIFICATION
  annee         String
  intitule      String
  etablissement String?
  ordre         Int     @default(0)

  @@index([consultantId])
}

// "05 — Expériences détaillées" (missions), 01 se déduit des N premières.
model Experience {
  id           String     @id @default(cuid())
  consultantId String
  consultant   Consultant @relation(fields: [consultantId], references: [id], onDelete: Cascade)

  entreprise             String // "Entreprise cliente" générique si NDA
  secteurActivite        String?
  missionTitre           String
  dateDebut              DateTime?
  dateFin                DateTime? // null = mission en cours
  contexteObjectif       String?
  realisations           String? // une réalisation par ligne
  environnementTechnique String?
  ordre                  Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([consultantId])
}

// ---------------------------------------------------------------------------
// Génération de leads (§5.4)
// ---------------------------------------------------------------------------

model ContactRequest {
  id           String     @id @default(cuid())
  consultantId String
  consultant   Consultant @relation(fields: [consultantId], references: [id], onDelete: Cascade)

  clientUserId String
  clientUser   User   @relation("ClientDemandeur", fields: [clientUserId], references: [id])

  besoin                 String
  localisation           String?
  dateDemarrageSouhaitee DateTime?

  status String @default("NOUVELLE") // NOUVELLE | EN_COURS | TRAITEE | SANS_SUITE

  // BM notifié au moment de la demande (le référent du consultant à cet instant).
  bmNotifieId String?
  bmNotifie   User?   @relation("BmNotifie", fields: [bmNotifieId], references: [id])

  // Réponse laissée par le back-office — visible par le client sur sa fiche
  // de demande (§ boucle de suivi, distincte de la trace CRM côté prospects).
  reponseNote  String?
  reponduLe    DateTime?
  reponduParId String?
  reponduPar   User?     @relation("DemandeRepondue", fields: [reponduParId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([consultantId])
  @@index([clientUserId])
  @@index([status])
}

// Demande de besoin "à froid" : le client décrit un poste à pourvoir sans
// viser un profil précis de la bibliothèque (à la différence de
// ContactRequest, toujours rattachée à un Consultant). Visible par
// l'ensemble du back-office (admin + BM) tant qu'aucun consultant/mission
// précis n'est identifié — pas de référent naturel à la création.
model DemandeBesoin {
  id           String @id @default(cuid())
  clientUserId String
  clientUser   User   @relation("ClientDemandeurBesoin", fields: [clientUserId], references: [id])

  intitulePoste          String
  descriptifPoste        String
  seniorite              String?
  tjmCibleMin            Int?
  tjmCibleMax            Int?
  localisation           String?
  dateDemarrageSouhaitee DateTime?
  dureeEstimee           String? // ex. "3 mois", "6-12 mois", "long terme"

  status String @default("NOUVELLE") // NOUVELLE | EN_COURS | TRAITEE | SANS_SUITE

  reponseNote  String?
  reponduLe    DateTime?
  reponduParId String?
  reponduPar   User?     @relation("DemandeBesoinRepondue", fields: [reponduParId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientUserId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Journalisation et traçabilité (§5.5)
// ---------------------------------------------------------------------------

model LoginLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  success   Boolean  @default(true)
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model ConsultationLog {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  consultantId String
  consultant   Consultant @relation(fields: [consultantId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@index([userId])
  @@index([consultantId])
  @@index([createdAt])
}
